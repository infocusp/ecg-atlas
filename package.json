{
  "name": "ecg-explorer",
  "version": "0.1.0",
  "description": "An educational 3D ECG explorer for electrode placement, cardiac rhythms, and electrical-mechanical timing.",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/check-browser.mjs && node scripts/check-blood-flow.mjs && node scripts/check-teaching.mjs && node scripts/check-public.mjs",
    "test:motion": "node scripts/check-motion.mjs",
    "signals:import": "node scripts/import-signals.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
